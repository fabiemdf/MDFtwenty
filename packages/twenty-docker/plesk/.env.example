# Plesk + DigitalOcean Twenty deployment
# Copy to .env on the droplet and fill every required value.
# Do not commit the real .env.

# Published image. Keep the official image unless this fork has custom code
# that must be baked in. Building the monorepo on a Plesk droplet will OOM.
TWENTY_IMAGE=twentycrm/twenty
TAG=latest

# Plesk nginx proxies to this loopback port. Do not publish 3000 on the
# public interface — DigitalOcean Cloud Firewall and ufw should leave it closed.
HOST_BIND=127.0.0.1
HOST_PORT=3000

# Public URL users type in the browser. Must match the Plesk domain and
# include https after Let's Encrypt is issued.
SERVER_URL=https://crm.example.com

# Generate with: openssl rand -base64 32
# Losing ENCRYPTION_KEY permanently locks every secret stored in the database.
ENCRYPTION_KEY=replace_me_with_openssl_rand_base64_32

# Generate with: openssl rand -hex 32
# Use letters and numbers only. Special characters break the compose URL.
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me_with_openssl_rand_hex_32
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

REDIS_URL=redis://redis:6379

# Local disk is fine for a single droplet. Prefer DigitalOcean Spaces in
# production so uploads survive droplet rebuilds.
STORAGE_TYPE=local

# DigitalOcean Spaces (S3-compatible). Uncomment when STORAGE_TYPE=S_3.
# STORAGE_S3_REGION=nyc3
# STORAGE_S3_NAME=your-space-name
# STORAGE_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false
